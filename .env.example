# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=""
# First admin account created by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# "test" = built-in test payment adapter (no money moves). "live" requires a gateway adapter + keys:
PAYMENT_MODE="test"
# STRIPE_SECRET_KEY=""        # needed only for PAYMENT_MODE=live with the Stripe adapter
# STRIPE_WEBHOOK_SECRET=""

# Public site URL, e.g. https://buntheory.com (sitemap, social previews)
NEXT_PUBLIC_SITE_URL=""
